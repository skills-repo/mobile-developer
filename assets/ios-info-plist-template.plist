<?xml version="1.0" encoding="UTF-8"?>
<!-- 移动端 iOS Info.plist 权限用途描述模板 —— 配合 scripts/check_permissions.py 自检 0 错误。
     所有 NS*UsageDescription 必须有非空、具体的用途文案，否则审核必拒。 -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>ExampleApp</string>
    <key>CFBundleDisplayName</key>
    <string>示例应用</string>
    <key>CFBundleIdentifier</key>
    <string>com.example.app</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>

    <!-- 相机：用于拍摄头像与扫码 -->
    <key>NSCameraUsageDescription</key>
    <string>用于拍摄个人头像与扫描二维码登录</string>

    <!-- 相册：用于上传与保存图片 -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>用于从相册选择图片上传，以及保存你生成的分享图</string>

    <!-- 定位：用于展示附近的服务点 -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>仅在应用前台时获取你的位置，用于显示附近的服务点</string>

    <!-- 麦克风：用于语音消息录制 -->
    <key>NSMicrophoneUsageDescription</key>
    <string>用于录制语音消息发送给好友</string>

    <!-- 通讯录：用于邀请手机联系人成为好友 -->
    <key>NSContactsUsageDescription</key>
    <string>用于从通讯录邀请好友，仅读取你选择的联系人</string>
</dict>
</plist>
